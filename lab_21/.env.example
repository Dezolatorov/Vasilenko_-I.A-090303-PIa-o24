# Копия в .env для локального запуска. Никогда не коммитьте .env.
APP_NAME=LibraryAPI
DATABASE_URL=sqlite:///./library.db
# В контейнере используйте PostgreSQL:
# DATABASE_URL=postgresql+psycopg://library:library@postgres:5432/library
SECRET_KEY=replace-me-with-long-random-secret-0123456789012345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
MAX_ACTIVE_LOANS=5
LOAN_DAYS=30
LOG_LEVEL=INFO