{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "REST API (app.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            "name": "REST API (пересоздать БД)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "args": ["--init-db"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            "name": "Тесты pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-v", "${workspaceFolder}/tests"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            "name": "SQL-запросы (demo_sql.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/demo_sql.py",
            "console": "integratedTerminal",
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            "name": "Структура БД (demo_schema.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/demo_schema.py",
            "console": "integratedTerminal",
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            "name": "Транзакции (demo_transaction.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/demo_transaction.py",
            "console": "integratedTerminal",
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            "name": "Redis-кэш (demo_cache.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/demo_cache.py",
            "console": "integratedTerminal",
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            "name": "CDN (demo_cdn.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/demo_cdn.py",
            "console": "integratedTerminal",
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            "name": "mini-redis :6379",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/mini_redis.py",
            "args": ["--port", "6379"],
            "console": "integratedTerminal"
        },
        {
            "name": "Origin :8080",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cdn/origin_server.py",
            "args": ["--port", "8080"],
            "console": "integratedTerminal"
        },
        {
            "name": "CDN edge :8081",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cdn/edge_server.py",
            "args": ["--port", "8081"],
            "console": "integratedTerminal"
        },
        {
            "name": "Клиент (меню)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/client.py",
            "console": "integratedTerminal",
            "env": { "PYTHONIOENCODING": "utf-8" }
        }
    ],
    "compounds": [
        {
            "name": "Вся инфраструктура (БД + Redis + CDN)",
            "configurations": ["mini-redis :6379", "Origin :8080", "CDN edge :8081", "REST API (app.py)"]
        }
    ]
}
