# Копия для локальной разработки: cp .env.example .env
# В Docker Compose используется docker-compose.yml (env берутся из переменных ниже).
# Для локального запуска без PostgreSQL замените USE_SQLITE на true.

APP_NAME=Library API
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL (используется в Docker Compose)
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=library
DATABASE_USER=library
DATABASE_PASSWORD=library_password

# Для локального теста без PostgreSQL (SQLite):
USE_SQLITE=false

# Секрет (не хранить в репозитории реальное значение!)
SECRET_KEY=change-me-in-production